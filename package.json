{
  "name": "msme-collections-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "build:submission": "node scripts/build-submission.mjs",
    "prisma:generate:local": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:generate:production": "npx prisma generate --schema prisma/schema.production.prisma",
    "prisma:validate:production": "npx prisma validate --schema prisma/schema.production.prisma",
    "db:deploy:production": "npx prisma migrate deploy --schema prisma/schema.production.prisma",
    "build:production": "npm run prisma:generate:production && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.15.3",
    "idb": "^8.0.4",
    "jose": "^6.2.16",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "archiver": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^6.4.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "minimatch": "^11.0.5"
  }
}
